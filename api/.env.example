# ─── FlowPro API — example configuration ────────────────────────────
# Copy to .env.development (local dev) or .env.production (deploy)
# and fill in real values. Never commit real secrets.

NODE_ENV=development
PORT=3001

# PostgreSQL — full connection string
DATABASE_URL=postgresql://USER@HOST:5432/DBNAME

# JWT — REQUIRED. Must be ≥32 chars in production and not the dev
# placeholder; the app refuses to boot in production otherwise.
JWT_SECRET=replace-with-a-strong-random-32-plus-char-secret
JWT_EXPIRES_IN=30d

# CORS allowlist — comma-separated. Must not contain "localhost" in
# production. Example: https://app.flowpro.io,https://staging.flowpro.io
CORS_ORIGIN=http://localhost:5173

# Build-info surfaced by /api/version. Wire these in your CI/CD.
# BUILD_SHA=
# BUILD_TIME=

# ─── AI / LLM configuration ─────────────────────────────────────────
# Pick a provider. "anthropic" is the default; "openai-compatible"
# targets any server that speaks OpenAI's /v1/chat/completions.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

# openai-compatible only — base URL (no trailing slash).
# LLM_BASE_URL=

# Legacy Anthropic-only key (still honored; prefer LLM_API_KEY).
ANTHROPIC_API_KEY=

# OS4 — Observability
# Log level for the pino logger: "trace" | "debug" | "info" | "warn" | "error" | "fatal".
# Defaults to "debug" in dev, "info" in production.
LOG_LEVEL=

# Sentry DSN — if set, unhandled 5xx errors get reported with correlation/tenant context.
# Leave empty to disable Sentry.
SENTRY_DSN=

# Optional version string sent to Sentry as the release tag (helps group errors by deploy).
APP_VERSION=
