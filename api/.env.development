# ─── API Development Environment ─────────────────────────────────────
NODE_ENV=development
PORT=3001

# Local PostgreSQL
DATABASE_URL=postgresql://vigneshmani@localhost:5432/flowpro

# JWT
JWT_SECRET=flowpro-dev-secret-key-change-in-production-min32
JWT_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# ─── AI / LLM configuration ──────────────────────────────────────────
# Pick a provider. "anthropic" is the default; "openai-compatible"
# targets any server that speaks OpenAI's /v1/chat/completions,
# including RunPod serverless vLLM, TGI, Ollama, LM Studio, Together,
# DeepInfra, Fireworks.
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai-compatible

# Model id. Anthropic expects a family name (claude-sonnet-4-6,
# claude-opus-4-6…); openai-compatible expects whatever the backing
# server accepts (meta-llama/Llama-3.3-70B-Instruct, mistral-7b-instruct,
# etc.). If unset, a sensible per-provider default kicks in.
# LLM_MODEL=claude-sonnet-4-6

# Shared credential — used by whichever provider is active. Preferred
# over the legacy per-provider env vars below. Both are read (LLM_API_KEY
# wins) so existing deployments don't have to rename their secret on
# upgrade.
LLM_API_KEY=

# openai-compatible only — base URL of the chat endpoint (no trailing
# slash). Examples:
#   RunPod serverless: https://api.runpod.ai/v2/<endpoint-id>/openai/v1
#   Local Ollama:      http://localhost:11434/v1
#   vLLM direct:       http://vllm.internal:8000/v1
# LLM_BASE_URL=

# Legacy Anthropic-only key. Still honored for backwards compatibility
# when LLM_PROVIDER=anthropic. Prefer LLM_API_KEY above for new
# deployments so swapping providers is a single env-var change.
ANTHROPIC_API_KEY=
